# ControlPlane.ai — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ============================================================
# OpenAI API (Optional)
# The demo works fully without this key using fixture data.
# Provide to enable live Tier 2 LLM evaluation for non-demo requests.
# ============================================================
OPENAI_API_KEY=your_openai_api_key_here
ENABLE_LIVE_SEMANTIC_EVALUATOR=false
SEMANTIC_EVALUATOR_MODEL=gpt-4o-mini

# ============================================================
# Database
# Default: ./data/controlplane.db (relative to project root)
# ============================================================
DATABASE_PATH=./data/controlplane.db

# ============================================================
# Application Settings
# ============================================================
NEXT_PUBLIC_APP_NAME=ControlPlane.ai

# Force all requests to use demo fixtures (useful for offline demos)
DEMO_MODE=false
DATASET_DEMO_TOKEN=replace-with-local-dataset-token

# Server-only controls for the destructive demo reset route.
DEMO_RESET_TOKEN=replace-with-local-demo-token
DEMO_REVIEWER_ID=demo-supervisor
NEXT_PUBLIC_DEMO_RESET_TOKEN=replace-with-local-demo-token

# Rate limiting: max requests per minute per IP
RATE_LIMIT_RPM=100
